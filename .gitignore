# ============================================================
# EDNO — Production .gitignore
# ============================================================

# ── Dependencies ────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js Build Outputs ───────────────────────────────────
/.next/
/out/
/build/
/dist/

# ── Environment Variables ────────────────────────────────────
# Never commit secrets. Use .env.example to document shape.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging

# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Testing & Coverage ───────────────────────────────────────
/coverage
/test-results
/playwright-report
/playwright/.cache

# ── Debug & Logs ─────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── OS Artifacts ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor / IDE ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.editorconfig

# ── Deployment ───────────────────────────────────────────────
.vercel
.netlify
.serverless

# ── Certificates & Secrets ───────────────────────────────────
*.pem
*.key
*.cert
*.p12

# ── Misc ─────────────────────────────────────────────────────
/tmp
/temp
.cache
AGENTS.md
CLAUDE.md
package-lock.json